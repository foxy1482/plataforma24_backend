# Copiar este archivo como ".env" y completar los valores reales.
# Las variables usan "__" como separador de secciones de appsettings.json.

# Cadena de conexion a PostgreSQL.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=plataforma24;Username=postgres;Password=cambiar

# Clave de firma de los JWT: minimo 32 caracteres, aleatoria y distinta en cada entorno.
Jwt__Key=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres